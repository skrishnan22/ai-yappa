{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "slack-agent",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Cloudflare collects Flue's native invoke_agent/chat/execute_tool spans.
	// Destination names are account-specific and are documented in README.md.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"destinations": ["honeycomb-logs"],
			"head_sampling_rate": 1,
			"persist": true,
		},
		"traces": {
			"enabled": true,
			"destinations": ["honeycomb-traces"],
			"head_sampling_rate": 1,
			"persist": true,
		},
	},
	// Flue generates bindings for agent Durable Objects; declare only
	// application-owned ones here. `CodexAuth` is exported from src/cloudflare.ts.
	"durable_objects": {
		"bindings": [{ "name": "CODEX_AUTH", "class_name": "CodexAuth" }],
	},
	// Every agent generates a Durable Object class named after its identity
	// (Hello -> FlueHelloAgent), and Cloudflare requires a migration entry
	// for each one. Application-owned classes need one too. Append a new tag
	// for each new class; never edit a deployed entry:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueCoworkerAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["CodexAuth"] },
	],
	// The app's one D1 database: memory (Person Preferences, Conversation
	// Digests) and planning decisions. It keeps its original Cloudflare name.
	// Apply migrations with: pnpm exec wrangler d1 migrations apply APP_DB --remote
	"d1_databases": [
		{
			"binding": "APP_DB",
			"database_name": "slack-agent-memory",
			"database_id": "d89b5f6b-5b02-41b2-aca0-85ff1923b6a5",
			"migrations_dir": "migrations",
		},
	],
}
