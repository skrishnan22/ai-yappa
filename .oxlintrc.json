{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["**/node_modules", "**/dist"],
	"categories": {
		"correctness": "off"
	},
	"jsPlugins": [
		{
			"name": "eslint-js",
			"specifier": "oxlint-plugin-eslint"
		}
	],
	"rules": {
		"eslint-js/no-restricted-syntax": [
			"error",
			{
				"selector": "ConditionalExpression AwaitExpression",
				"message": "Don't use await inside a ternary; use if/else."
			},
			{
				"selector": "ConditionalExpression > ArrowFunctionExpression[async=true]",
				"message": "Don't use an async function as a ternary branch; use if/else."
			},
			{
				"selector": "ConditionalExpression > FunctionExpression[async=true]",
				"message": "Don't use an async function as a ternary branch; use if/else."
			},
			{
				"selector": "ConditionalExpression Property[value.async=true]",
				"message": "Don't put an async method inside a ternary; use if/else."
			}
		]
	}
}
