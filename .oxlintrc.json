{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["**/node_modules", "**/dist"],
	"options": {
		"typeAware": true
	},
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"oxc",
		"import",
		"node",
		"promise",
		"vitest"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"jsPlugins": [
		{
			"name": "eslint-js",
			"specifier": "oxlint-plugin-eslint"
		}
	],
	"rules": {
		"eslint/no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		],
		"typescript/no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		],
		"eslint/no-underscore-dangle": [
			"warn",
			{
				"allow": [
					"_exhaustive",
					"__resetSlackClientForTests",
					"__resetRunCardForTests"
				]
			}
		],
		"unicorn/require-post-message-target-origin": "off",
		"unicorn/require-module-specifiers": "off",
		"unicorn/consistent-function-scoping": "off",
		"eslint-js/no-restricted-syntax": [
			"error",
			{
				"selector": "ConditionalExpression AwaitExpression",
				"message": "Don't use await inside a ternary; use if/else."
			},
			{
				"selector": "ConditionalExpression > ArrowFunctionExpression[async=true]",
				"message": "Don't use an async function as a ternary branch; use if/else."
			},
			{
				"selector": "ConditionalExpression > FunctionExpression[async=true]",
				"message": "Don't use an async function as a ternary branch; use if/else."
			},
			{
				"selector": "ConditionalExpression Property[value.async=true]",
				"message": "Don't put an async method inside a ternary; use if/else."
			}
		]
	}
}
