{
	"name": "slack-agent",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22.22.1"
	},
	"scripts": {
		"dev": "pnpm run build:render && vite dev",
		"build": "pnpm run build:render && vite build",
		"build:render": "node scripts/build-render-assets.mjs",
		"deploy": "pnpm run build && wrangler deploy",
		"check:types": "tsc --noEmit && tsc --noEmit -p render",
		"check:env": "node scripts/check-env-sync.mjs",
		"lint": "oxlint src",
		"fmt": "oxfmt src .oxlintrc.json .oxfmtrc.json package.json wrangler.jsonc tsconfig.json",
		"fmt:check": "oxfmt --check src .oxlintrc.json .oxfmtrc.json package.json wrangler.jsonc tsconfig.json",
		"gitleaks": "gitleaks git --redact --no-banner --verbose",
		"gitleaks:staged": "gitleaks git --pre-commit --staged --redact --no-banner --verbose",
		"prepare": "husky",
		"test": "vitest run",
		"tunnel": "sh scripts/run-tunnel.sh",
		"tunnel:setup": "sh scripts/setup-tunnel.sh",
		"tunnel:stop": "sh scripts/stop-tunnel.sh"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "1.4.0",
		"@daytona/sdk": "^0.207.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@flue/runtime": "^2.0.3",
		"@flue/slack": "^2.0.3",
		"@slack/web-api": "^8.1.1",
		"croner": "^10.0.1",
		"cronstrue": "^3.31.0",
		"damerau-levenshtein": "^1.0.8",
		"hono": "4.12.32",
		"jose": "^6.2.12",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@flue/cli": "^2.0.3",
		"@flue/vite": "^2.0.3",
		"@oxlint/plugins": "1.82.0",
		"@types/damerau-levenshtein": "^1.0.2",
		"@types/node": "^22.10.10",
		"@valibot/to-json-schema": "^1.8.0",
		"echarts": "6.1.0",
		"husky": "^9.1.7",
		"lantern": "https://codeload.github.com/ivarvong/lantern/tar.gz/2c7bad533be25fbd56d26a9a2b6c5651743f011e",
		"lint-staged": "^17.5.1",
		"mermaid": "12.2.0",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-plugin-eslint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vega": "6.4.0",
		"vega-interpreter": "2.3.2",
		"vega-lite": "6.5.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.11",
		"wrangler": "^4.113.0"
	},
	"pnpm": {
		"overrides": {
			"@earendil-works/pi-ai": "1.1.0"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"manim-js",
			"workerd"
		]
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs}": [
			"oxlint",
			"oxfmt"
		],
		"*.{json,jsonc}": "oxfmt"
	}
}
