		"hono": "4.12.32",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@flue/cli": "^2.0.3",
		"@flue/vite": "^2.0.3",
		"@types/node": "^22.10.10",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"vitest": "^4.1.11",
		"wrangler": "^4.113.0"
	}
