{
	"name": "slack-agent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.22.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"check:types": "tsc --noEmit",
		"check:env": "node scripts/check-env-sync.mjs",
		"lint": "oxlint src",
		"fmt": "oxfmt src .oxlintrc.json .oxfmtrc.json package.json wrangler.jsonc tsconfig.json",
		"fmt:check": "oxfmt --check src .oxlintrc.json .oxfmtrc.json package.json wrangler.jsonc tsconfig.json",
		"gitleaks": "node scripts/gitleaks.mjs git --redact --no-banner --verbose",
		"gitleaks:staged": "node scripts/gitleaks.mjs git --pre-commit --staged --redact --no-banner --verbose",
		"prepare": "husky",
		"test": "vitest run",
		"tunnel": "sh scripts/run-tunnel.sh",
		"tunnel:setup": "sh scripts/setup-tunnel.sh",
		"tunnel:stop": "sh scripts/stop-tunnel.sh"
	},
	"dependencies": {
		"@daytona/sdk": "^0.207.0",
		"@earendil-works/pi-ai": "0.86.0",
		"@flue/runtime": "^2.0.3",
		"@flue/slack": "^2.0.3",
		"@slack/web-api": "^8.1.1",
		"hono": "4.12.32",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@flue/cli": "^2.0.3",
		"@flue/vite": "^2.0.3",
		"@oxlint/plugins": "1.82.0",
		"@types/node": "^22.10.10",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-plugin-eslint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"vitest": "^4.1.11",
		"wrangler": "^4.113.0"
	},
	"overrides": {
		"@earendil-works/pi-ai": "0.86.0"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs}": [
			"oxlint",
			"oxfmt"
		],
		"*.{json,jsonc}": "oxfmt"
	}
}
